{
  "builds": [
    { "src": "package.json", "use": "@vercel/next" },
    { "src": "api/run.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/fetch", "dest": "/pages/api/fetch.js" },
    { "src": "/api/run", "dest": "/api/run.py" },
    { "src": "/(.*)", "dest": "/pages/$1" }
  ]
}
