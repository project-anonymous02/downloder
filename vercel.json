{
  "builds": [
    { "src": "pages/api/fetch.js", "use": "@vercel/node" },
    { "src": "py/run.py", "use": "@vercel/python" },
    { "src": "pages/**/*.js", "use": "@vercel/next" }
  ],
  "routes": [
    { "src": "/api/fetch", "dest": "/pages/api/fetch.js" },
    { "src": "/py/run", "dest": "/py/run.py" },
    { "src": "/(.*)", "dest": "/pages/$1" }
  ]
}
